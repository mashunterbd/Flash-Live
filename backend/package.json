{
  "name": "flash-live-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Flash Live RTMP & Multi-Destination Management Backend",
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "node scripts/patch-agent.js",
    "dev": "tsx watch src/index.ts",
