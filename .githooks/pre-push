#!/bin/sh
# Pre-push quality gate for Flash Live
# Blocks git push if lint, test, or build fails on protected branches.

set -e

run_checks() {
  echo "[Pre-Push] Running full verification suite..."
  
  echo "[1/6] Linting backend..."
  (cd backend && npm run lint) || { echo "❌ Backend lint failed!"; exit 1; }

  echo "[2/6] Testing backend..."
  (cd backend && npm test) || { echo "❌ Backend tests failed!"; exit 1; }

  echo "[3/6] Building backend..."
  (cd backend && npm run build) || { echo "❌ Backend build failed!"; exit 1; }

  echo "[4/6] Linting frontend..."
  (cd frontend && npm run lint) || { echo "❌ Frontend lint failed!"; exit 1; }

  echo "[5/6] Testing frontend..."
  (cd frontend && npm test) || { echo "❌ Frontend tests failed!"; exit 1; }

  echo "[6/6] Building frontend..."
  (cd frontend && npm run build) || { echo "❌ Frontend build failed!"; exit 1; }

  echo "✅ All pre-push checks passed successfully!"
}

echo "=================================================="
echo " Running Pre-Push Quality Gate for Flash Live..."
echo "=================================================="

# Check if input is provided via stdin (invoked by git push)
if [ -t 0 ]; then
  # Running in terminal/standalone without stdin piped
  run_checks
else
  has_input=0
  while read local_ref local_oid remote_ref remote_oid; do
    has_input=1
    case "$remote_ref" in
      refs/heads/main|refs/heads/master|refs/heads/staging)
        echo "[Pre-Push] Target branch: $remote_ref."
        run_checks
        ;;
      *)
        echo "[Pre-Push] Pushing to feature branch ($remote_ref). Skipping strict gate."
        ;;
    esac
  done
  if [ "$has_input" -eq 0 ]; then
    run_checks
  fi
fi

exit 0
